{
  "openapi": "3.0.3",
  "info": {
    "title": "AI-Powered E-Commerce Customer Support & Refund API",
    "version": "1.0.0",
    "description": "REST API for customer support tickets, multi-turn AI agent chat with RAG policy retrieval, idempotent refund execution (₹5,000 auto-refund threshold), human escalation workflow, and audit logging."
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "customer",
                  "staff"
                ]
              }
            }
          },
          "token": {
            "type": "string"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "security": [],
        "responses": {
          "200": {
            "description": "Service and database healthy"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register a new customer account",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "email",
                  "password"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 6
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created"
          },
          "409": {
            "description": "Email already registered"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login and obtain JWT token",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated successfully"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Get authenticated user profile",
        "responses": {
          "200": {
            "description": "Current user"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/orders": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "List orders (scoped to authenticated customer, or all for staff)",
        "responses": {
          "200": {
            "description": "Order list"
          }
        }
      }
    },
    "/api/orders/{id}": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "Get single order by UUID or order_number (customer-scoped)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order details"
          },
          "404": {
            "description": "Order not found or inaccessible"
          }
        }
      }
    },
    "/api/tickets": {
      "get": {
        "tags": [
          "Tickets"
        ],
        "summary": "List support tickets",
        "responses": {
          "200": {
            "description": "Ticket list"
          }
        }
      },
      "post": {
        "tags": [
          "Tickets"
        ],
        "summary": "Create support ticket and trigger initial AI agent response",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "subject",
                  "description"
                ],
                "properties": {
                  "subject": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "category": {
                    "type": "string"
                  },
                  "priority": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "order_id": {
                    "type": "string",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ticket created with AI reply"
          }
        }
      }
    },
    "/api/tickets/{id}": {
      "get": {
        "tags": [
          "Tickets"
        ],
        "summary": "Get ticket details, conversation history, refunds, and escalations",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ticket bundle"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/api/tickets/{id}/messages": {
      "post": {
        "tags": [
          "Tickets"
        ],
        "summary": "Send a chat message on a ticket (customer turns trigger AI agent + tools)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "content"
                ],
                "properties": {
                  "content": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Message recorded and AI response generated"
          }
        }
      }
    },
    "/api/refunds": {
      "get": {
        "tags": [
          "Refunds"
        ],
        "summary": "List refund requests",
        "responses": {
          "200": {
            "description": "Refund list"
          }
        }
      },
      "post": {
        "tags": [
          "Refunds"
        ],
        "summary": "Submit an idempotent refund request (server-enforced ₹5,000 cap & window checks)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "order_id",
                  "ticket_id",
                  "reason",
                  "idempotency_key"
                ],
                "properties": {
                  "order_id": {
                    "type": "string"
                  },
                  "ticket_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "amount": {
                    "type": "number"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "idempotency_key": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent replay returned existing refund"
          },
          "201": {
            "description": "Refund approved and created"
          },
          "400": {
            "description": "Invalid request or expired return window"
          },
          "403": {
            "description": "Above ₹5,000 auto-refund threshold"
          }
        }
      }
    },
    "/api/escalations": {
      "get": {
        "tags": [
          "Escalations"
        ],
        "summary": "List escalations (staff sees all; customer sees own)",
        "responses": {
          "200": {
            "description": "Escalations list"
          }
        }
      }
    },
    "/api/admin/tickets": {
      "get": {
        "tags": [
          "Admin / Staff"
        ],
        "summary": "Staff queue with status, priority, escalated, and search filters",
        "responses": {
          "200": {
            "description": "Staff ticket queue"
          },
          "403": {
            "description": "Staff role required"
          }
        }
      }
    },
    "/api/admin/tickets/{id}": {
      "get": {
        "tags": [
          "Admin / Staff"
        ],
        "summary": "Detailed staff ticket inspection including customer, order, messages, refunds, escalations, and audit logs",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Inspection bundle"
          }
        }
      }
    },
    "/api/admin/tickets/{id}/status": {
      "patch": {
        "tags": [
          "Admin / Staff"
        ],
        "summary": "Update ticket status",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Status updated"
          }
        }
      }
    },
    "/api/admin/escalations/{id}/decision": {
      "post": {
        "tags": [
          "Admin / Staff"
        ],
        "summary": "Staff decision on an escalation (approved / rejected / more_info_requested)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "decision"
                ],
                "properties": {
                  "decision": {
                    "type": "string",
                    "enum": [
                      "approved",
                      "rejected",
                      "more_info_requested"
                    ]
                  },
                  "internal_note": {
                    "type": "string"
                  },
                  "refund_amount": {
                    "type": "number"
                  },
                  "customer_message": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision applied and audited"
          },
          "400": {
            "description": "Approval needs a linked order"
          },
          "409": {
            "description": "Escalation was already decided"
          }
        }
      }
    },
    "/api/admin/refunds/{id}/decision": {
      "post": {
        "tags": [
          "Admin / Staff"
        ],
        "summary": "Staff decision on a refund (approved / rejected)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "decision"
                ],
                "properties": {
                  "decision": {
                    "type": "string",
                    "enum": [
                      "approved",
                      "rejected"
                    ]
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Refund updated and audited"
          },
          "404": {
            "description": "Refund not found"
          },
          "409": {
            "description": "Refund already has that status or was rejected"
          }
        }
      }
    },
    "/api/admin/audit-logs": {
      "get": {
        "tags": [
          "Admin / Staff"
        ],
        "summary": "List recent audit log entries",
        "responses": {
          "200": {
            "description": "Audit logs"
          }
        }
      }
    }
  }
}